<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>filzmann_permission_matrix</id>
    <name>Berechtigungsmatrix</name>
    <summary>Read-only Berechtigungsmatrix und Positivlisten-Audit fuer Nextcloud-Gruppenrechte.</summary>
    <description>Dokumentiert gruppenbezogene App-Verfuegbarkeit, bekannte Berechtigungsquellen, Snapshots, Baselines, Diffs und Exporte ohne Nextcloud-Berechtigungen zu veraendern.</description>
    <version>0.2.2</version>
    <licence>agpl</licence>
    <author>Simon Filzmann</author>
    <namespace>FilzmannPermissionMatrix</namespace>
    <category>organization</category>
    <bugs>https://github.com/Filzmann/nextcloud-filzmann-permission-matrix/issues</bugs>
    <dependencies>
        <nextcloud min-version="29" max-version="35"/>
    </dependencies>
    <background-jobs>
        <job>OCA\FilzmannPermissionMatrix\BackgroundJob\ScanJob</job>
    </background-jobs>
    <commands>
        <command>OCA\FilzmannPermissionMatrix\Command\ScanCommand</command>
        <command>OCA\FilzmannPermissionMatrix\Command\ExportCommand</command>
        <command>OCA\FilzmannPermissionMatrix\Command\BaselineSetCommand</command>
        <command>OCA\FilzmannPermissionMatrix\Command\BaselineShowCommand</command>
        <command>OCA\FilzmannPermissionMatrix\Command\DiffCommand</command>
        <command>OCA\FilzmannPermissionMatrix\Command\StatusCommand</command>
    </commands>
    <settings>
        <admin>OCA\FilzmannPermissionMatrix\Settings\Admin</admin>
        <admin-section>OCA\FilzmannPermissionMatrix\Settings\AdminSection</admin-section>
    </settings>
</info>
